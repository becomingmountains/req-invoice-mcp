# Free from https://dashboard.request.network (Manage route -> Client IDs). Use one of these two:
REQUEST_CLIENT_ID=
# REQUEST_API_KEY=

# Optional: only if your Client ID is restricted to a domain.
# REQUEST_ORIGIN=

# Your dashboard "Route ID". Enables create_payment_link.
REQUEST_DESTINATION_ID=""  # keep the quotes: the Route ID contains "#"

# Default wallet that receives payments for create_invoice.
REQUEST_PAYEE=
