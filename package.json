    "invoice",
    "crypto",
    "ai-agents"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/becomingmountains/req-invoice-mcp.git"
  },
  "homepage": "https://becomingmountains.github.io/req-invoice-mcp/",
  "bugs": {
    "url": "https://github.com/becomingmountains/req-invoice-mcp/issues"
  }
